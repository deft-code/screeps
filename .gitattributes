# Line endings: store LF in the repository and check out LF on every platform,
# whatever core.autocrlf says locally. Editors are told the same by .editorconfig.
* text=auto eol=lf

# Shell scripts must stay LF or bash on Windows rejects them.
*.sh text eol=lf

# Nothing binary is tracked today; declared so git never normalises these if added.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
